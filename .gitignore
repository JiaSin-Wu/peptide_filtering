__pycache__/
*.pyc
*.pyo
*.log
.env

# Per-run pipeline state (checkpoints and a per-order copy of final_results.csv)
filter/pipeline_state/

# Structure prediction outputs (100+GB, never track)
structures/

# AF3 daemon I/O (mounted into af3_daemon container, see start_af3_daemon.sh)
GA/af3/

# Vendored third-party tool repos - re-fetch separately instead of tracking
filter/*/tools/algpred2/
filter/*/tools/toxinpred2/
filter/*/tools/toxinpred3/
filter/*/tools/temp_embeddings/

# Downloaded reference database (MMseqs2 human proteome) + scratch dirs
filter/**/human_proteome*
filter/**/self_similarity/tmp*/

# Licensed third-party binaries (e.g. FoldX) - not redistributable
filter/**/foldx

# NOTE: stage results under filter/*/outputs/ are deliberately tracked -- they are
# the evidence behind the funnel. They used to be ignored here and force-added,
# which meant a new stage result was silently skipped by `git add -A`.

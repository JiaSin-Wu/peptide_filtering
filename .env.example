# Copy to .env and edit for your machine (.env is gitignored, do not commit it).
# A real environment variable overrides .env.

# --- required ---
# Docker image containing AlphaFold 3
AF3_IMAGE=jiasin/alphafold3:latest
# Directory with the AF3 weights (af3.bin)
AF3_MODEL_DIR=/opt/model_parameter
# Directory with the AF3 genetic databases (uniref90, mgnify, bfd, pdb_seqres, ...)
AF3_DB_DIR=/opt/af3_databases

# --- optional (defaults shown) ---
# jackhmmer threads per search (peptide MSA step)
AF3_MSA_CPUS=8
# Fraction of GPU memory AF3 may take; lower it on a shared GPU
AF3_MEM_FRACTION=0.90
